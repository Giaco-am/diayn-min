{
  "_comment": "MODIFICA DIRICHLET: parametri v2, nomi condivisi con Giaco; salvataggio solo finale.",
  "env": "pointnav",
  "n_skills": 3,
  "steps": 20000,
  "seed": 10,
  "device": "cpu",
  "torch_threads": 1,
  "latent_type": "dirichlet",
  "prior_alpha": 0.05,
  "gamma": 0.99,
  "tau": 0.005,
  "alpha": 0.1,
  "lr": 0.0003,
  "batch_size": 256,
  "hidden": 300,
  "replay_size": 100000,
  "start_steps": 1000,
  "update_after": 1000,
  "max_episode_steps": 100,
  "posterior_total_concentration_min": 0.01,
  "posterior_total_concentration_max": 1000,
  "discriminator_grad_clip": 10,
  "reset_buffer_on_change": true,
  "log_every": 1000
}
