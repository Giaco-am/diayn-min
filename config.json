{
  "env": "InvertedPendulum-v5",
  "n_skills":20,
  "steps": 300000,
  "seed": 10,
  "device": "cpu",

  "gamma": 0.99,
  "tau": 0.005,
  "alpha": 0.1,
  "lr": 0.0003,
  "batch_size": 256,
  "hidden": 300,
  "replay_size": 1000000,
  "start_steps": 1000,
  "update_after": 1000,
  "max_episode_steps": 1000 ,

  "disc_updates": 1,
  "policy_updates": 1,

  "log_every": 1000,
  "save_every": 25000,

  "ratios": [[1, 1], [5, 1],[10, 1], [1, 2], [1,5], [1,10]],
  "seeds": [10, 11, 12, 13, 14],

  "hierarchical": {
    "goal_grid": 5,
    "subset_samples": 30
  }
}
